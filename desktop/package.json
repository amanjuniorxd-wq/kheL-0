{
  "name": "sahayata-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Sahayata desktop shell — a native window around the deployed Sahayata web app.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis portable",
    "dist:mac": "electron-builder --mac dmg",
    "dist:linux": "electron-builder --linux AppImage"
  },
  "devDependencies": {
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.sahayata.desktop",
    "productName": "Sahayata",
    "files": ["main.js", "config.json", "not-configured.html"],
    "directories": { "buildResources": "build" },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "mac": { "icon": "build/icon.ico", "target": "dmg" },
    "linux": { "icon": "build/icon.ico", "target": "AppImage" }
  }
}
