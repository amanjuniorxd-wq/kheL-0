# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only, used by the Edge Function

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Payments — enable whichever gateways you want live; the Checkout modal
# only shows tabs for providers whose public keys are set. All four post
# to the single unified webhook at /api/webhooks/payments.

# Stripe — Visa, MasterCard, international cards
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Razorpay — UPI (Google Pay, PhonePe, Paytm, BHIM) + Indian cards
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret   # set in Razorpay dashboard > Webhooks, separate from the API key secret

# Cashfree — alternate UPI + local card processor
NEXT_PUBLIC_CASHFREE_APP_ID=your-cashfree-app-id
CASHFREE_APP_ID=your-cashfree-app-id
CASHFREE_SECRET_KEY=your-cashfree-secret-key
CASHFREE_ENV=sandbox   # sandbox | production
NEXT_PUBLIC_CASHFREE_ENV=sandbox   # sandbox | production (client SDK reads this one)

# PayPal & Venmo (Venmo checkout is US-only and requires PayPal Braintree/Venmo approval)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id
PAYPAL_ENV=sandbox   # sandbox | live
